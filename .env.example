# ==============================================================================
# SERVER-SENTRY: ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# Unique server identifier (displayed as a badge in all Telegram notifications)
SERVER_NAME=PROD-MAIN-01

# ------------------------------------------------------------------------------
# Telegram Bot Notifications
# ------------------------------------------------------------------------------
# 1. Create a bot with @BotFather on Telegram using /newbot and copy the HTTP API token
TELEGRAM_BOT_TOKEN=

# 2. Send /start to your bot, then get your chat ID via:
#    curl -s "https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates"
# (Use group/channel ID if you want alerts shared with your team, e.g., -100...)
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Web Service Ports
# ------------------------------------------------------------------------------
UPTIME_KUMA_PORT=3001
BESZEL_PORT=8090

# ------------------------------------------------------------------------------
# Beszel Agent (Host Hardware Metrics)
# ------------------------------------------------------------------------------
# Public key generated when clicking "Add System" in Beszel Hub (port 8090)
# Always keep double quotes around the key because public keys contain a space.
# Example: BESZEL_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5..."
BESZEL_KEY=

# ------------------------------------------------------------------------------
# Resource Alert Thresholds (%)
# ------------------------------------------------------------------------------
ALERT_DISK_THRESHOLD_PERCENT=85
ALERT_RAM_THRESHOLD_PERCENT=90

# ------------------------------------------------------------------------------
# Safe Docker Cleanup Retention (Janitor)
# ------------------------------------------------------------------------------
# Deletes dangling/unused images and dead containers older than this duration
PRUNE_UNTIL_HOURS=72h

# ------------------------------------------------------------------------------
# Autoheal (Self-Healing Container Restarts)
# ------------------------------------------------------------------------------
# Interval in seconds between container health checks
AUTOHEAL_INTERVAL=20
# Grace period in seconds after system boot before monitoring begins
AUTOHEAL_START_PERIOD=60
